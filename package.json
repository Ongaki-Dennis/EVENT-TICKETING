{
  "name": "eventful",
  "version": "1.0.0",
  "description": "Event ticketing platform with auth, Paystack payments, QR tickets, reminders, analytics, caching, and API docs.",
  "main": "server.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/src/server.js",
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node server.js",
    "test": "vitest run --pool=threads --testTimeout=10000"
  },
  "keywords": [
    "events",
    "ticketing",
    "paystack",
    "qrcode",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "nodemailer": "^8.0.10",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
